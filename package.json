{
  "name": "food-education-workspace",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "baseline:create": "node tools/refactor-baseline.mjs create",
    "catalog:generate": "node tools/generate-mini-catalog.mjs",
    "catalog:check": "node tools/generate-mini-catalog.mjs --check",
    "catalog:validate": "tsx packages/catalog-core/tools/verify-snapshot.ts apps/miniprogram/src/data/catalog.json",
    "mini:config": "tsx tools/validate-mini-public-content.ts",
    "test:mini-config": "tsx --test tools/tests/mini-public-content.test.ts",
    "test:mini-reading": "node tools/check-mini-reading-layout.mjs",
    "test:mini-photos": "node tools/check-mini-photos.mjs",
    "test:mini-catalog-photos": "node tools/check-mini-catalog-photos.mjs",
    "test:mini-education": "node tools/check-mini-education-recovery.mjs",
    "test:mini-storage": "node tools/check-mini-storage-recovery.mjs",
    "test:mini-browser-ci": "node --test tools/tests/mini-browser-ci.test.mjs",
    "demo:record": "node --import tsx tools/record-product-demo.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present && npm run typecheck:photo-research",
    "typecheck:photo-research": "tsc --noEmit -p tsconfig.research.json",
    "photo-research:check": "tsx tools/research/check-photo-leads.ts",
    "test:photo-research": "tsx --test tools/tests/photo-research.test.ts && node --test tools/tests/photo-research-isolation.test.mjs",
    "test:photo-research:local": "tsx --test tools/tests/photo-research-local.test.ts",
    "test:source-boundaries": "node --test tools/tests/source-boundaries.test.mjs",
    "test:workspace-source": "node --test tools/tests/workspace-source.test.mjs",
    "test:archive-compat": "node --test tools/tests/archive-extractor-compat.test.mjs",
    "verify:workspace-clean-install": "node tools/verify-workspace-clean-install.mjs --offline",
    "source:export": "node tools/export-workspace-source.mjs",
    "test:source-archive": "node --test tools/tests/source-archive.test.mjs",
    "test": "npm run test --workspace @food-education/catalog-core && node --test tools/tests/mini-package.test.mjs && npm run test:mini-browser-ci && npm run test:mini-config && npm run test:photo-research && npm run test:source-boundaries && npm run test:archive-compat && npm run catalog:validate",
    "test:publication-client": "tsx --test tools/integration/public-education-http.test.mjs",
    "test:publication-browser": "npm --prefix zhongyi-platform run test:publication-client:browser",
    "build:mini": "npm run catalog:check && npm run build:weapp --workspace @food-education/miniprogram && node tools/inspect-mini-package.mjs",
    "build:mini:verify": "npm run catalog:check && npm run mini:config && node tools/build-mini-verification.mjs",
    "dev:mini": "npm run dev:weapp --workspace @food-education/miniprogram",
    "wechat:prepare": "node tools/prepare-mini-project.mjs",
    "legacy:check": "npm --prefix zhongyi run check",
    "platform:typecheck": "npm --prefix zhongyi-platform run typecheck",
    "platform:dev": "npm --prefix zhongyi-platform run dev"
  },
  "devDependencies": {
    "decompress": "file:packages/archive-extractor-compat",
    "@types/node": "22.15.0",
    "esbuild": "0.25.12",
    "sass": "1.105.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "overrides": { "decompress": "$decompress" }
}
