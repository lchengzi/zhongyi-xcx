# Workspace-root build context. Only this Dockerfile's explicit inputs are sent.
**
!zhongyi-platform/
!zhongyi-platform/package.json
!zhongyi-platform/package-lock.json
!zhongyi-platform/tsconfig.json
!zhongyi-platform/tsconfig.server.json
!zhongyi-platform/tsconfig.publication-tests.json
!zhongyi-platform/tsconfig.local-demo-tests.json
!zhongyi-platform/tsconfig.https-tests.json
!zhongyi-platform/tsconfig.web-tests.json
!zhongyi-platform/tsconfig.request-log-tests.json
!zhongyi-platform/tsconfig.publication-client-browser.json
!zhongyi-platform/tsconfig.assistant-tests.json
!zhongyi-platform/tsconfig.photo-processing.json
!zhongyi-platform/photo-processing/
!zhongyi-platform/photo-processing/*.ts
!zhongyi-platform/playwright.config.ts
!zhongyi-platform/vite.config.ts
!zhongyi-platform/index.html
!zhongyi-platform/server/
!zhongyi-platform/server/**/*.ts
!zhongyi-platform/shared/
!zhongyi-platform/shared/**/*.ts
!zhongyi-platform/web/
!zhongyi-platform/web/**/*.ts
!zhongyi-platform/web/**/*.tsx
!zhongyi-platform/web/**/*.css
!zhongyi-platform/tools/
!zhongyi-platform/tools/*.ts
!zhongyi-platform/tests/
!zhongyi-platform/tests/**/*.ts
!zhongyi-platform/data/
!zhongyi-platform/data/catalog.seed.json
!packages/
!packages/catalog-core/
!packages/catalog-core/src/
!packages/catalog-core/src/**/*.ts
!zhongyi-platform/Dockerfile
!zhongyi-platform/Dockerfile.dockerignore
# Never include credentials, working databases, archives or generated evidence.
**/.env
**/.env.*
**/*.sqlite
**/*.sqlite-*
**/*.zfbackup
**/*.pem
**/*.key
**/node_modules/**
**/.local/**
**/.refactor/**
