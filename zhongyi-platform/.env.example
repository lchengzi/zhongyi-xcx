# Reference only: the application does not automatically load .env files.
# Set variables in your shell or deployment secret manager. Do not commit secrets.
AUTH_MODE=accounts
PORT=4310
# Default loopback; containers explicitly use 0.0.0.0 with accounts + exact origins.
BIND_HOST=127.0.0.1
DB_PATH=.local/editorial.sqlite
DATABASE_PROVIDER=sqlite
# Server-only capability, not a client flag. Keep off until content and release
# authority are verified. Approval/resume alone never publish a snapshot.
EDUCATION_PUBLICATION_ENABLED=false
# Optional PRIVATE account-only photo preview; omitted by default. Both must be
# absolute paths. Never place private originals under the web static directory.
# PRIVATE_PHOTO_ROOT=<absolute-path-to-private-photo-root>
# PRIVATE_PHOTO_MANIFEST=<absolute-path-to-manifest-inside-that-root>
# See docs/private-photo-preview.md. Empty/partial settings fail, not fall back.
# Optional display-photo publication. Explicit directories must already exist,
# be disjoint, and stay outside static hosting. Defaults off; approvals alone
# do not publish. Asset journal is NOT included in existing SQL backups.
ENABLE_PHOTO_PUBLICATION=false
# PHOTO_DERIVATIVE_ROOT=<absolute-path-to-prepared-derivative-bundle-directory>
# PHOTO_PUBLICATION_ROOT=<absolute-path-to-private-append-only-publication-journal>
# See docs/photo-publication.md before enabling or restoring these assets.
# Host operator ONLY: photo:backup export/verify/restore. Independent secret;
# never mount into server, publish, commit, or send in chat. Set ONLY one source.
# PHOTO_RESOURCE_BACKUP_KEY_FILE=<absolute-path-to-base64-32-random-byte-secret>
# PHOTO_RESOURCE_BACKUP_KEY=<standard-Base64-of-32-random-bytes>
# See docs/photo-resource-backup.md; SQL association is not an atomic snapshot.
# Separate file-only container operators: compose.photos.yaml. No database URL
# secret. See docs/container-photo-operations.md for required host mount paths;
# never pass PHOTO_BACKUP_* or the photo key to the ordinary server container.
ALLOWED_ORIGINS=http://127.0.0.1:4310,http://localhost:4310,http://127.0.0.1:5173,http://localhost:5173
# Production: explicit direct HTTPS, exact HTTPS origin(s), external certificate files.
# Reverse-proxy termination is NOT enabled implicitly or by forwarded headers.
TLS_MODE=off
# TLS_MODE=direct
# TLS_CERT_FILE=<absolute-path-to-PEM-leaf-first-certificate-chain>
# TLS_KEY_FILE=<absolute-path-to-matching-unencrypted-private-key>
# Optional health client CA for a private test CA; public certs use Node trust roots.
# TLS_HEALTH_CA_FILE=<absolute-path-to-private-test-CA-certificate>
# Local demo only: AUTH_MODE=local-key; optional EDITOR_TOKEN (minimum 32 characters).
# Bootstrap only: optional BOOTSTRAP_PASSWORD; never use a production default.
# Runtime switch is explicit: DATABASE_PROVIDER=postgres (no SQLite fallback).
# Migrate to a new named schema first; then configure both variables below.
# DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>
# The URL above is a non-production local demo only. With NODE_ENV=production,
# all PostgreSQL server/operator pools require an explicit sslmode=verify-full.
# DATABASE_URL=postgresql://<user>:<password>@<certificate-host>:5432/<database>?sslmode=verify-full
# Private CA: append &sslrootcert=<URL-encoded-absolute-CA-path> and mount it
# separately. TLS_HEALTH_CA_FILE verifies HTTPS, NOT the database certificate.
# DATABASE_SCHEMA=food_education
# Runtime/owner separation: prepare existing restricted roles with the operator
# db:runtime-role:postgres -- --apply|--verify --schema <schema> --role <runtime>.
# That operator uses the owner DATABASE_URL; the server uses a DIFFERENT runtime
# secret. Do not mount the owner secret into a long-running application.
# Production stores now enforce this read-only audit before serving requests.
# No opt-out: owner/superuser, excess or missing privileges refuse startup.
# See docs/postgres-runtime-permissions.md; development demos remain unchanged.
# Container entrypoint: production server/bootstrap require DATABASE_RUNTIME_URL_FILE.
# Production init/migrate/backup/runtime-role require DATABASE_OWNER_URL_FILE.
# Mount ONLY the command's credential; never set both, legacy file or DATABASE_URL.
# Legacy DATABASE_URL_FILE=/run/secrets/database_url is for nonproduction demo only.
# See compose.restricted.yaml and docs/container-credential-separation.md.
# db:migrate:postgres requires an explicit --source and NEW --schema.
# Existing PostgreSQL v1-v5 requires explicit --upgrade --schema before v6 code.
# Operator CLI only: db:backup:postgres uses explicit --schema and --output/--input.
# BACKUP_ENCRYPTION_KEY=<independent-secret: standard Base64 of 32 random bytes>
# Container backup command ONLY: BACKUP_ENCRYPTION_KEY_FILE=/run/secrets/backup_encryption_key
# Container export: BACKUP_OUTPUT_DIRECTORY=/archive-output
# Container restore: BACKUP_INPUT_DIRECTORY=/archive-input (read-only mount)
# Never pass these key/archive settings to server/bootstrap/ordinary operators.
# See compose.backup.yaml and docs/container-backup-recovery.md; real mounts unverified.
# Keep the backup key separate from backup files and outside the repo/chat.
# Restores require a NEW schema and revoke all restored login sessions.
# AI remains disabled until the provider, rights, fees and external transfer are approved.
AI_PROVIDER=disabled
AI_EXTERNAL_ENABLED=false
# Durable call-count limits per UTC day, shared by all instances using this database.
# First reserved call fixes the day's policy; mismatched instances fail, not reset it.
# Failed/cancelled reserved calls count. These are NOT monetary/provider billing limits.
AI_DAILY_CALL_LIMIT=20
AI_ACTOR_DAILY_CALL_LIMIT=5
# Optional real integration (server-side secret manager only; never paste keys in chat):
# AI_PROVIDER=openai
# AI_EXTERNAL_ENABLED=true
# OPENAI_API_KEY=<server-secret>
# AI_MODEL=<explicit-supported-model>
# Optional verified USD per million token prices; omit both for unknown cost.
# AI_INPUT_USD_PER_MILLION=<input-price>
# AI_OUTPUT_USD_PER_MILLION=<output-price>
