.ingredient-card {
  box-sizing: border-box;
  overflow: hidden;
  padding: 28rpx;
  border: 1rpx solid #e0e7de;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(29, 60, 47, 0.035);
}

button::after {
  border: 0;
}

.ingredient-card__head {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.ingredient-card__identity {
  flex: 1 1 260rpx;
  min-width: 0;
  overflow-wrap: anywhere;
}

.ingredient-card__title {
  color: #173e31;
  font-size: 40rpx;
  font-weight: 750;
  line-height: 1.25;
}

.ingredient-card__pinyin {
  margin-top: 6rpx;
  color: #65766c;
  font-size: 23rpx;
}

.status-pill {
  flex: 0 0 auto;
  box-sizing: border-box;
  max-width: 100%;
  overflow-wrap: anywhere;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #e8f1e9;
  color: #2f6b45;
  font-size: 22rpx;
  line-height: 1.3;
}

.status-pill--warning {
  background: #fff0d1;
  color: #7b581b;
}

.status-pill--blocked {
  background: #fbe8e4;
  color: #9a4034;
}

.ingredient-card__meta {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx 18rpx;
  margin-top: 18rpx;
  color: #607067;
  font-size: 24rpx;
}

.ingredient-card__summary {
  margin-top: 18rpx;
  color: #33463b;
  line-height: 1.65;
}

.ingredient-card__part-review {
  margin-top: 10rpx;
  color: #74561d;
  font-size: 23rpx;
  line-height: 1.55;
  overflow-wrap: anywhere;
}

.reason-list {
  margin-top: 20rpx;
  padding: 14rpx 18rpx;
  border-left: 4rpx solid #c5d7c8;
  border-radius: 0 12rpx 12rpx 0;
  background: #f4f7f2;
}

.ingredient-card__search-match {
  margin-top: 14rpx;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background: #f1f5ef;
  color: #435448;
  font-size: 24rpx;
  line-height: 1.6;
  overflow-wrap: anywhere;
}

.ingredient-card__search-note {
  margin-top: 8rpx;
  color: #74561d;
}

.reason-list__label {
  margin-bottom: 8rpx;
  color: #2f6b45;
  font-size: 23rpx;
  font-weight: 700;
}

.reason-item {
  color: #56665c;
  font-size: 24rpx;
  line-height: 1.55;
}

.reason-item::before {
  content: "· ";
}

.blocked-note,
.warning-note {
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
  line-height: 1.55;
}

.blocked-note {
  background: #fff0ed;
  color: #8b392f;
}

.warning-note {
  background: #fff8e8;
  color: #74561d;
}

.ingredient-card__actions {
  display: grid;
  grid-template-columns: 1fr 1fr 1.15fr;
  gap: 12rpx;
  margin-top: 24rpx;
}

.card-action {
  min-width: 0;
  min-height: 48px;
  margin: 0;
  padding: 13rpx 8rpx;
  border: 1rpx solid #cddbd0;
  border-radius: 18rpx;
  background: #ffffff;
  color: #245b46;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.3;
  white-space: normal;
}

.card-action--disabled {
  border-color: #e2ded5;
  background: #f1efe9;
  color: #9b9d99;
}

.card-action--primary {
  border-color: #245b46;
  background: #245b46;
  color: #fff;
}

.ingredient-card--compact .reason-list,
.ingredient-card--compact .ingredient-card__summary {
  display: none;
}

@media (max-width: 390px) {
  .ingredient-card__actions {
    grid-template-columns: 1fr 1fr;
  }

  .card-action--primary {
    grid-column: 1 / -1;
  }
}
